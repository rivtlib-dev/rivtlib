{
    "name": "rivtlib-codespace",
    "image": "mcr.microsoft.com/devcontainers/python:3.14-bookworm",
    "workspaceFolder": "/workspaces/rivtlib/rivt-example-01",
    "updateContentCommand": "bash /workspaces/rivtlib/.devcontainer/prepare-workspace.sh",
    "postCreateCommand": "bash /workspaces/rivtlib/.devcontainer/post-create.sh",
    "postAttachCommand": "bash /workspaces/rivtlib/.devcontainer/post-attach.sh",
    "waitFor": "updateContentCommand",
    "customizations": {
        "codespaces": {
            "openFiles": [
                "rivt-report/rv001-doc-example01.py"
            ]
        },
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/workspaces/rivtlib/.venv/bin/python",
                "python.venvPath": "/workspaces/rivtlib",
                "python.analysis.typeCheckingMode": "basic",
                "python.terminal.activateEnvironment": true
            }
        }
    }
}